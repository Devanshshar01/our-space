{
  "name": "couple-space",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/apply-migrations.ts",
    "test": "dotenv -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.local -- vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.1",
    "better-auth": "1.2.7",
    "drizzle-orm": "0.41.0",
    "next": "15.2.3",
    "postgres": "3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.30.5",
    "eslint": "9.22.0",
    "eslint-config-next": "15.2.3",
    "jsdom": "26.0.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}