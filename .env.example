# Couple Space Environment Variables
# Copy this file to .env.local and fill in values

# Database (PostgreSQL - Neon compatible)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Child app URLs (used by the app launcher)
NEXT_PUBLIC_CANVAS_APP_URL=http://localhost:3001
NEXT_PUBLIC_NOTES_APP_URL=http://localhost:3002